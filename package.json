{
  "name": "timemachine",
  "displayName": "TimeMachine — Your project's flight recorder",
  "description": "Record local project activity between passing and failing test runs, with file saves, terminal commands, checkpoints, and coding time.",
  "version": "1.6.0",
  "publisher": "itstushar",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/TusharAnand303/timemachine_vscode.git"
  },
  "bugs": "https://github.com/TusharAnand303/timemachine_vscode/issues",
  "homepage": "https://github.com/TusharAnand303/timemachine_vscode#readme",
  "icon": "media/marketplace.png",
  "galleryBanner": {
    "color": "#0D1631",
    "theme": "dark"
  },
  "keywords": [
    "coding time",
    "time tracking",
    "command history",
    "terminal history",
    "local history",
    "activity timeline",
    "file snapshots",
    "ai-assisted coding",
    "developer productivity",
    "focus time",
    "file changes",
    "test failures",
    "debugging",
    "restore",
    "privacy",
    "offline"
  ],
  "preview": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Visualization",
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:timemachine.timeline",
    "onCommand:timemachine.openTimeline",
    "onView:timemachine.focus"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "timemachine",
          "title": "TimeMachine",
          "icon": "media/timemachine.svg"
        }
      ]
    },
    "views": {
      "timemachine": [
        {
          "id": "timemachine.focus",
          "name": "Coding Time",
          "type": "webview"
        },
        {
          "id": "timemachine.timeline",
          "name": "Project Timeline"
        },
        {
          "id": "timemachine.folders",
          "name": "Project Folders"
        }
      ]
    },
    "commands": [
      {
        "command": "timemachine.openTimeline",
        "title": "TimeMachine: Open Activity Graph"
      },
      {
        "command": "timemachine.openGraph",
        "title": "TimeMachine: Open Activity Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "timemachine.searchCommands",
        "title": "TimeMachine: Search Command History"
      },
      {
        "command": "timemachine.whatChanged",
        "title": "TimeMachine: What Changed?"
      },
      {
        "command": "timemachine.createCheckpoint",
        "title": "TimeMachine: Create Checkpoint"
      },
      {
        "command": "timemachine.compareWithCheckpoint",
        "title": "TimeMachine: Compare With Checkpoint"
      },
      {
        "command": "timemachine.showSessionSummary",
        "title": "TimeMachine: Show Session Summary"
      },
      {
        "command": "timemachine.startCoding",
        "title": "TimeMachine: Start Coding Timer"
      },
      {
        "command": "timemachine.startAi",
        "title": "TimeMachine: Start AI-Assisted Timer"
      },
      {
        "command": "timemachine.pauseTimer",
        "title": "TimeMachine: Pause Coding Timer"
      },
      {
        "command": "timemachine.showInGraph",
        "title": "TimeMachine: Show in Activity Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "timemachine.showStatus",
        "title": "TimeMachine: Check Setup"
      },
      {
        "command": "timemachine.refresh",
        "title": "TimeMachine: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "timemachine.viewChange",
        "title": "TimeMachine: View Saved Version"
      },
      {
        "command": "timemachine.compare",
        "title": "TimeMachine: Compare Change"
      },
      {
        "command": "timemachine.restore",
        "title": "TimeMachine: Restore Before Change"
      },
      {
        "command": "timemachine.exportReport",
        "title": "TimeMachine: Export Project Activity Report",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "timemachine.openGraph",
          "when": "false"
        },
        {
          "command": "timemachine.viewChange",
          "when": "false"
        },
        {
          "command": "timemachine.compare",
          "when": "false"
        },
        {
          "command": "timemachine.restore",
          "when": "false"
        },
        {
          "command": "timemachine.showInGraph",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "timemachine.viewChange",
          "when": "view == timemachine.timeline && viewItem == save",
          "group": "inline@1"
        },
        {
          "command": "timemachine.compare",
          "when": "view == timemachine.timeline && viewItem == save",
          "group": "inline@2"
        },
        {
          "command": "timemachine.restore",
          "when": "view == timemachine.timeline && viewItem == save",
          "group": "navigation@3"
        },
        {
          "command": "timemachine.showInGraph",
          "when": "view == timemachine.timeline && viewItem =~ /event|save/",
          "group": "inline@4"
        }
      ],
      "view/title": [
        {
          "command": "timemachine.openGraph",
          "when": "view == timemachine.timeline",
          "group": "navigation@1"
        },
        {
          "command": "timemachine.refresh",
          "when": "view == timemachine.timeline || view == timemachine.folders",
          "group": "navigation"
        },
        {
          "command": "timemachine.exportReport",
          "when": "view == timemachine.timeline",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "npm run compile-tests && mocha --ui tdd out/test/timeline.test.js out/test/storage.test.js out/test/report.test.js",
    "vsix": "vsce package --out releases/timemachine-1.6.0.vsix",
    "test": "vscode-test"
  },
  "dependencies": {
    "diff": "^8.0.4"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "pricing": "Free",
  "author": {
    "name": "Tushar Anand"
  },
  "qna": "https://github.com/TusharAnand303/timemachine_vscode/issues"
}
