{
  "name": "timemachine",
  "displayName": "TimeMachine",
  "description": "A local timeline of file saves, terminal commands, and failures between Git commits.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "timemachine", "title": "TimeMachine", "icon": "media/timemachine.svg" }
      ]
    },
    "views": {
      "timemachine": [
        { "id": "timemachine.timeline", "name": "Timeline" }
      ]
    },
    "commands": [
      { "command": "timemachine.openTimeline", "title": "TimeMachine: Open Timeline" },
      { "command": "timemachine.viewChange", "title": "TimeMachine: View Saved Version" },
      { "command": "timemachine.compare", "title": "TimeMachine: Compare Change" },
      { "command": "timemachine.restore", "title": "TimeMachine: Restore Before Change" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "timemachine.viewChange", "when": "false" },
        { "command": "timemachine.compare", "when": "false" },
        { "command": "timemachine.restore", "when": "false" }
      ],
      "view/item/context": [
        { "command": "timemachine.viewChange", "when": "view == timemachine.timeline && viewItem == save", "group": "inline@1" },
        { "command": "timemachine.compare", "when": "view == timemachine.timeline && viewItem == save", "group": "inline@2" },
        { "command": "timemachine.restore", "when": "view == timemachine.timeline && viewItem == save", "group": "navigation@3" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "npm run compile-tests && mocha --ui tdd out/test/timeline.test.js out/test/storage.test.js",
    "test": "vscode-test"
  },
  "dependencies": {
    "diff": "^8.0.4"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
